# Vorlage für /etc/bewaesserung/zugang.env (root:root, chmod 600). NIE echte Werte ins Repo.
# Später schreibt die Einrichtungsseite (deploy/firstboot) diese Datei.
GARDENA_APPLICATION_KEY=
GARDENA_APPLICATION_SECRET=
# Optional, sonst wird der erste Standort genommen:
# GARDENA_STANDORT_ID=
# Standard ist Trockenlauf. Erst nach Phase-0-Tests bewusst auf false setzen:
GARDENA_DRY_RUN=true
